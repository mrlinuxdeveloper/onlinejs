<!doctype html><html lang="<%= lang %>" dir="<%= dir %>"><head><%- include('partials/head') %><title>Lootlane — Player marketplace</title></head><body>
<%- include('partials/nav') %>
<main class="shell">
 <section class="hero"><div class="hero-copy"><span class="eyebrow"><i></i> <%= t('بازار آیتم‌های گیمرها','THE PLAYER-TO-PLAYER MARKET') %></span><h1><%- t('آیتم بعدیِ بازی‌ات،<br> همین‌جاست.','Your next<br>game-changing find.') %></h1><p><%= t('آیتم‌های خاص بازی را پیدا کن، یا چیزی که داری را به بازیکن بعدی بسپار.','Discover rare game items, or pass your own gear to its next player.') %></p><a class="button primary" href="#market"><%= t('گشتن در بازار','Explore marketplace') %> <span>↗</span></a><div class="hero-proof"><div class="avatar-stack"><b>R</b><b>M</b><b>K</b><b>+</b></div><span><strong><%= t('معامله بین بازیکن‌ها','Player-powered trading') %></strong><small><%= t('از بازی، برای بازی','Made by gamers, for gamers') %></small></span></div></div><div class="hero-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="hero-glow"></div><div class="hero-item">⚔️</div><div class="floating-tag tag-top">✦ <%= t('آیتم‌های کمیاب','RARE DROPS') %></div><div class="floating-tag tag-bottom"><span class="pulse"></span> <%= t('آیتم تازه ثبت شد','NEW ITEM LISTED') %></div><div class="hero-caption">001 / LOOTLANE<span>GEAR UP. PASS IT ON.</span></div></div></section>
 <section class="stats"><div><strong>1.2k<span>+</span></strong><small><%= t('آیتم برای کشف','items to discover') %></small></div><div><strong>48</strong><small><%= t('بازی پشتیبانی‌شده','games supported') %></small></div><div><strong>24<span>/7</span></strong><small><%= t('بازار همیشه باز','market is always open') %></small></div><div class="stats-note"><span>✳</span><%= t('ساخته‌شده برای بازیکن‌ها','BUILT FOR THE PLAYERS') %></div></section>
 <section class="market" id="market"><div class="section-heading"><div><span class="eyebrow"><i></i> <%= t('اتاق غنیمت','THE LOOT ROOM') %></span><h2><%- t('پیدا کردن چیز خوب،<br> شانسی نیست.','The good stuff<br> doesn’t stay hidden.') %></h2></div><a class="text-link" href="/dashboard"><%= t('فروش یک آیتم','Sell an item') %> ↗</a></div>
 <form class="filters" action="/" method="get"><label class="search"><span>⌕</span><input name="q" value="<%= filters.query %>" placeholder="<%= t('دنبال چی می‌گردی؟','Search items, games, categories...') %>"><button aria-label="Search">↵</button></label><select name="game" onchange="this.form.submit()"><option value=""><%= t('همه بازی‌ها','All games') %></option><% games.forEach(game => { %><option value="<%= game %>" <%= filters.game===game?'selected':'' %>><%= game %></option><% }) %></select><span class="result-count"><%= listings.length %> <%= t('آیتم پیدا شد','ITEMS FOUND') %></span></form>
 <div class="item-grid"><% listings.forEach((item, i) => { %><article class="item-card"><a class="item-image" href="#item-<%= item.id %>"><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><span class="rarity rarity-<%= item.rarity.toLowerCase() %>"><%= item.rarity %></span><span class="card-index">0<%= i+1 %></span></a><div class="item-info"><div class="item-game"><%= item.game %><span>·</span><%= item.platform %></div><h3><%= item.title %></h3><div class="item-bottom"><span class="seller"><i><%= item.seller[0] %></i><%= item.seller %></span><strong><%= money(item.price) %></strong></div><form method="post" action="/listings/<%= item.id %>/buy"><button class="buy-button"><%= t('درخواست خرید','Buy item') %><span>↗</span></button></form></div></article><% }) %></div>
 <% if (!listings.length) { %><div class="empty"><span>⌕</span><h3><%= t('چیزی پیدا نشد','No loot found') %></h3><p><%= t('فیلترها را تغییر بده یا اولین آیتمت را برای فروش بگذار.','Try another search or list the first item.') %></p></div><% } %>
 </section><section class="sell-banner"><div><span class="eyebrow"><i></i> <%= t('نوبت توئه','YOUR MOVE') %></span><h2><%- t('کوله‌پشتی‌ات جا نداره؟<br> به یکی دیگه خوشحالی بده.','Inventory full?<br>Make another player’s day.') %></h2></div><a class="button light" href="/dashboard"><%= t('آیتمت رو ثبت کن','List your item') %> ↗</a><span class="banner-mark">✳</span></section>
</main><%- include('partials/footer') %></body></html>
