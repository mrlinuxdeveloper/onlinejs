<!doctype html><html lang="<%= lang %>" dir="<%= dir %>"><head><%- include('partials/head') %><title><%= t('مدیریت بازار','Marketplace admin') %> — Lootlane</title></head><body><%- include('partials/nav') %><main class="shell dashboard admin-page"><div class="dashboard-head"><div><span class="eyebrow"><i></i> LOOTLANE / ADMIN CONSOLE</span><h1><%= t('مدیریت بازار','Marketplace admin') %></h1><p><%= t('آگهی‌ها را بررسی کن و وضعیت نمایششان را مدیریت کن.','Review listings and control their visibility.') %></p></div><form method="post" action="/admin/logout"><button class="nav-sell"><%= t('خروج','Sign out') %></button></form></div><% if(notice) { %><div class="notice"><%= notice==='deleted'?t('آگهی حذف شد.','Listing deleted.'):t('تغییر ذخیره شد.','Changes saved.') %></div><% } %><div class="admin-stats"><div class="panel"><small><%= t('کل آگهی‌ها','TOTAL LISTINGS') %></small><strong><%= stats.total %></strong></div><div class="panel"><small><%= t('فعال','ACTIVE') %></small><strong><%= stats.active || 0 %></strong></div><div class="panel"><small><%= t('فروخته‌شده','SOLD') %></small><strong><%= stats.sold || 0 %></strong></div></div><section class="panel admin-table-panel"><div class="panel-heading"><div><span class="eyebrow"><i></i> MODERATION</span><h2><%= t('آخرین آگهی‌ها','Latest listings') %></h2></div><span class="step-count"><%= listings.length %> / 100</span></div><div class="admin-listings"><% listings.forEach(item=>{ %><article class="admin-row"><img src="<%= item.image %>" alt=""><div class="admin-item-name"><b><%= item.title %></b><small><%= item.game %> · <%= item.seller %></small></div><strong><%= money(item.price) %></strong><form method="post" action="/admin/listings/<%= item.id %>/status"><select name="status"><% ['active','hidden','sold'].forEach(status=>{ %><option value="<%= status %>" <%= item.status===status?'selected':'' %>><%= status %></option><% }) %></select><button class="buy-button"><%= t('ذخیره','Save') %></button></form><form method="post" action="/admin/listings/<%= item.id %>/delete" onsubmit="return confirm('<%= t('این آگهی حذف شود؟','Delete this listing?') %>')"><button class="delete-button" aria-label="Delete">×</button></form></article><% }) %><% if(!listings.length){ %><div class="empty"><h3><%= t('آگهی‌ای وجود ندارد','No listings yet') %></h3></div><% } %></div></section><p class="admin-footnote"><%= t('حساب مدیر نسخه‌ی دمو از تنظیمات محیطی خوانده می‌شود. برای استقرار عمومی، رمز و کلید نشست را تغییر بده.','Demo admin credentials come from environment settings. Change the password and session secret before public deployment.') %></p></main><%- include('partials/footer') %></body></html>
