<%- include('./partials/head.ejs', { title: 'انتشار خبر' }) %><body>
<%- include('./partials/nav.ejs', { active: '' }) %>
<main class="wrap form-page"><a class="back-link" href="/">← بازگشت به صفحه اصلی</a><div class="form-intro"><span class="eyebrow eyebrow-dark">صدای شما مهم است</span><h1>خبر تازه‌ای دارید؟</h1><p>جزئیات را بنویسید تا با مخاطبان روایت امروز به اشتراک بگذارید.</p></div>
<form class="editor-form" action="/addblog" method="post"><% if (typeof error !== 'undefined' && error) { %><p class="form-error"><%= error %></p><% } %><label for="title">عنوان خبر <span>اجباری</span></label><input id="title" name="title" type="text" maxlength="160" placeholder="یک عنوان روشن و دقیق بنویسید" value="<%= typeof values !== 'undefined' ? values.title : '' %>" required><div class="field-hint">حداکثر ۱۶۰ نویسه</div><label for="content">متن خبر <span>اجباری</span></label><textarea id="content" name="content" rows="10" placeholder="اصل ماجرا چیست؟ جزئیات را اینجا بنویسید…" required><%= typeof values !== 'undefined' ? values.content : '' %></textarea><div class="form-footer"><span>پیش از انتشار، اطلاعات را بازبینی کنید.</span><button class="button button-primary" type="submit">انتشار خبر <span>←</span></button></div></form></main>
<%- include('./partials/footer.ejs') %></body></html>
