<!doctype html><html lang="<%= lang %>" dir="<%= dir %>"><head><%- include('partials/head') %><title><%= t('ورود مدیر','Admin sign in') %> — Lootlane</title></head><body><%- include('partials/nav') %><main class="shell dashboard"><section class="panel admin-login"><span class="eyebrow"><i></i> LOOTLANE / ADMIN</span><h1><%= t('ورود مدیر','Admin sign in') %></h1><p><%= t('برای دسترسی به مدیریت آگهی‌ها وارد شو.','Sign in to manage marketplace listings.') %></p><% if (error) { %><div class="notice error"><%= error %></div><% } %><form method="post" action="/admin/login" class="form-grid"><label class="wide"><%= t('نام کاربری','USERNAME') %><input name="username" required autocomplete="username"></label><label class="wide"><%= t('رمز عبور','PASSWORD') %><input type="password" name="password" required autocomplete="current-password"></label><button class="button primary wide submit-listing"><%= t('ورود','Sign in') %> ↗</button></form><a class="text-link" href="/">← <%= t('بازگشت به بازار','Back to marketplace') %></a></section></main><%- include('partials/footer') %></body></html>
