<%- include('./partials/head.ejs', { title: blog.title }) %><body><%- include('./partials/nav.ejs', { active: '' }) %><main class="wrap article-page"><a class="back-link" href="/">← همهٔ خبرها</a><article><div class="article-cover"><span>روایت امروز</span><div class="cover-sun"></div><span class="cover-caption">گزارش و تحلیل</span></div><div class="article-content"><div class="card-meta"><span><i></i> خبر و تحلیل</span><time datetime="<%= blog.createdAt.toISOString() %>"><%= new Intl.DateTimeFormat('fa-IR', { dateStyle: 'full' }).format(blog.createdAt) %></time></div><h1><%= blog.title %></h1><div class="article-rule"></div><p class="article-text"><%= blog.content %></p><div class="article-actions"><a class="button button-primary" href="/editblog/<%= blog._id %>">ویرایش خبر</a><form action="/deleteblog/<%= blog._id %>" method="post" onsubmit="return confirm('این خبر حذف شود؟')"><button class="button button-outline" type="submit">حذف خبر</button></form></div></div></article></main><%- include('./partials/footer.ejs') %></body></html>
