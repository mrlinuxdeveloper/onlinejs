<!doctype html><html lang="<%= lang %>" dir="<%= dir %>"><head><%- include('partials/head') %><title><%= t('داشبورد فروشنده','Seller dashboard') %> — Lootlane</title></head><body><%- include('partials/nav') %><main class="shell dashboard"><div class="dashboard-head"><div><span class="eyebrow"><i></i> <%= t('فضای بازیکن','PLAYER SPACE') %></span><h1><%= t('داشبورد تو','Your dashboard') %></h1><p><%= t('آیتم‌هایت را مدیریت کن یا چیز تازه‌ای برای فروش بگذار.','Manage your listings or add something new to the market.') %></p></div><div class="player-chip"><span>Y</span><div><b><%= t('بازیکن نمونه','Demo player') %></b><small>PLAYER · LEVEL 08</small></div><i>⌄</i></div></div>
<% if (error) { %><div class="notice error"><%= error %></div><% } %><% if (query.created) { %><div class="notice"><%= t('آیتمت با موفقیت به بازار اضافه شد.','Your item is now listed on the marketplace.') %></div><% } %>
<div class="dashboard-layout"><section class="panel listing-form"><div class="panel-heading"><div><span class="eyebrow"><i></i> <%= t('آگهی جدید','NEW LISTING') %></span><h2><%= t('آیتمت را ثبت کن','List an item') %></h2></div><span class="step-count">01 <i>/</i> 01</span></div><form action="/listings" method="post" class="form-grid"><label class="wide"><%= t('اسم آیتم','ITEM NAME') %><input required name="title" maxlength="80" placeholder="e.g. Dragonfire Blade"></label><label><%= t('بازی','GAME') %><input required name="game" maxlength="60" placeholder="e.g. Elden Ring"></label><label><%= t('پلتفرم','PLATFORM') %><select name="platform"><option>PC</option><option>PlayStation 5</option><option>Xbox Series X|S</option><option>Nintendo Switch</option><option>Mobile</option></select></label><label><%= t('دسته‌بندی','CATEGORY') %><select name="category"><option>Weapon</option><option>Cosmetic</option><option>Collectible</option><option>Armor</option><option>Currency</option><option>Other</option></select></label><label><%= t('کمیابی','RARITY') %><select name="rarity"><option>Common</option><option>Rare</option><option>Epic</option><option>Legendary</option><option>Mythic</option></select></label><label><%= t('قیمت (دلار)','PRICE (USD)') %><div class="price-input"><span>$</span><input type="number" min="0.01" max="100000" step="0.01" required name="price" placeholder="0.00"></div></label><label class="wide"><%= t('لینک تصویر','IMAGE URL') %><input required type="url" name="image" placeholder="https://..."></label><label class="wide"><%= t('توضیحات','DESCRIPTION') %><textarea name="description" maxlength="300" rows="3" placeholder="<%= t('یک توضیح کوتاه درباره آیتمت...','Tell players a little about this item...') %>"></textarea></label><button class="button primary wide submit-listing"><%= t('انتشار در بازار','Publish listing') %><span>↗</span></button></form></section>
<section class="panel inventory"><div class="panel-heading"><div><span class="eyebrow"><i></i> <%= t('قفسه‌ی تو','YOUR INVENTORY') %></span><h2><%= t('آیتم‌های من','My listings') %> <span class="count-pill"><%= listings.length %></span></h2></div><span class="step-count"><%= t('فعال','ACTIVE') %></span></div><% if (listings.length) { %><div class="my-listings"><% listings.forEach(item => { %><article class="my-item"><img src="<%= item.image %>" alt=""><div><b><%= item.title %></b><small><%= item.game %> · <%= item.platform %></small><span class="rarity-label rarity-<%= item.rarity.toLowerCase() %>"><%= item.rarity %></span></div><strong><%= money(item.price) %></strong><span class="status-pill <%= item.status %>"><%= item.status %></span></article><% }) %></div><% } else { %><div class="inventory-empty"><span>▧</span><h3><%= t('هنوز آیتمی نذاشتی','No items listed yet') %></h3><p><%= t('وقتی آگهی بسازی، اینجا می‌بینیش.','Your listings will show up here.') %></p></div><% } %><div class="seller-tip"><span>✦</span><p><b><%= t('یه نکته برای فروش بهتر','TIP FOR SELLERS') %></b><br><%= t('عکس روشن و توضیح دقیق کمک می‌کنه آیتمت زودتر دیده بشه.','Clear photos and honest details help items get noticed.') %></p></div></section></div></main><%- include('partials/footer') %></body></html>
